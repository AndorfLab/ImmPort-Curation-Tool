{ 
  "$schema":"http://json-schema.org/draft-04/schema",
  "title":"assessments.json template schema",
  "description":"The assessment panels template defines and annotates the assessment panels and the assessment components (results) defines and annotates the assessment for the panel. Assessment panels are often encoded in Case Report Forms (CRFs) and these are linked to a study. Assessment components are the answers to questions or assessments recorded in a CRF for a given subject within a study. The assessment template enables you to define the panel and its components in a single form.  The assessment panel can be either new or pre-defined in this template. Any combination is acceptable. The only restriction is that the assessment panel id is the key to the template and must be unique within the template.",
  "type":"object",
  "properties":{
    "userDefinedId":{
    "type":"string","maxLength":200
    },
    "plannedVisitId":{
    "type":"string", "maxLength":15
    },
    "nameReported":{
    "type":"string","maxLength":150
    },
    "studyDay":{
    "type":"number"
    },
    "ageAtOnsetReported":{
    "type":"string","maxLength":100
    },
    "ageAtOnsetUnitReported":{
    "type":"string","enum":["d.p.c.","Days","Hours","Minutes","Months","Not Specified","Seconds","Weeks","Years"]
    },
    "isClinicallySignificant":{
    "type":"string","maxLength":1
    },
    "locationOfFindingReported":{
    "type":"string","maxLength":256
    },
    "organOrBodySystemReported":{
    "type":"string","maxLength":100
    },
    "resultValueReported":{
    "type":"string",
    "maxLength":250
    },
    "resultUnitReported":{
    "type":"string","enum":["AFU","AI","Antibody titer","Arithmetic Mean Fluorescence Intensity Unit (aMFI)","AU/ml","Base Pair Unit","BCLC Stage","Beats per Minute","Body Mass Index Finding","Boolean","Breaths per Minute","C","Capsule Dosing Unit","categorical","cells","cells/kg body weight","cells/ml","cells/ul","CFU","CFU/ml","cm","Count","Cq","Ct","Day","Delta Ct","Delta Delta Ct","DK units/ml","Donor Information","Dose","F","FPKM","g/dl","g/l","Gender","Geometric Mean Fluorescence Intensity Unit (gMFI)","gm","Grade","Gy","HAU","Hour","in","IU","iu/l","IU/ml","K","Kallikrein Inactivator Unit per Milliliter","kg","kg/m2","l","L/sec","m","Mean Fluorescence Intensity Unit (MFI,FIU)","Median Fluorescence Intensity Unit (MdFI)","MFI at 90th percentile","mg","mg/dl","mg/l","mg/ml","Milligram per Kilogram","miu/ml","ml","mL/min","mL/min/(173/100).m2","mL/min/mmHg","mm","mmHg","MOI","Month","Multidimensional Fatigue Inventory","ng","ng/dl","ng/ml","ng/nl","ng/ul","nl","nM","Normalized Fluorescence Intensity Unit","Not Specified","NPX","Number of Episodes","optical density","percentage","PFU","PFUe","pg","pg/mg creatinine","pg/ml","pg/nl","pg/ul","pl","pM","Point","Pound","Ratio","Relative Fluorescence Intensity Unit","RPKM","Scale","Schirmer Test Wetting","Score","stim/unstim fold change","TCID50","Thousand Cells per Microliter","titer","TPM","ug","ug/dl","ug/kg","ug/l","ug/ml","ug/ul","ugEq/g","uiu/ml","ul","uM","umol/l","Unit per Gram","units/ml","Week","Year","Yes, No, or Unknown Response","Z-Score"], ,"maxLength":25
    },
    "resultValueCategory":{
    "type":"string","maxLength":40
    },
    "subjectPositionReported":{
    "type":"string","maxLength":40
    },
    "timeOfDay":{
    "type":"string","maxLength":40
    },
    "verbatimQuestion":{
    "type":"string","maxLength":250
    },
    "whoIsAssessed":{
    "type":"string","maxLength":40
    }
    },
  "required":["userDefinedId","plannedVisitId","nameReported","studyDay"]
}
